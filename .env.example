# Copia este archivo como .env.local y pega los valores de tu proyecto Supabase.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
# Solo controla qué cuenta ve la pestaña de administración; la seguridad real está en Supabase.
VITE_ADMIN_EMAIL=tu-correo@empresa.com
# Correo interno usado detrás de la pantalla de acceso de vendedoras.
VITE_SALES_EMAIL=ventas@empresa.com
